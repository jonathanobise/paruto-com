/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# HTML, CSS and JS keep Cloudflare's default (revalidate every time: unchanged files answer 304), so a deploy is
# picked up at once. Files below rarely change; they're cached longer. None of the paths below overlap.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/vendor/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/assets/products/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/assets/logos/*
  Cache-Control: public, max-age=604800

/assets/icons/*
  Cache-Control: public, max-age=604800

/assets/og/*
  Cache-Control: public, max-age=604800
